[Unit]
Description=Apply panel color-correction 3D LUT to VOP2 CUBIC_LUT hardware
After=emulationstation.service
ConditionPathExists=/etc/panel-lut/current.lut

[Service]
Type=oneshot
ExecStart=/usr/local/bin/apply-panel-lut /etc/panel-lut/current.lut
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
