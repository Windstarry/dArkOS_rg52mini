diff --git a/xbmc/windowing/gbm/RGARotate.cpp b/xbmc/windowing/gbm/RGARotate.cpp
new file mode 100644
index 0000000..8b12cfa
--- /dev/null
+++ b/xbmc/windowing/gbm/RGARotate.cpp
@@ -0,0 +1,118 @@
+/*
+ *  Copyright (C) 2005-2018 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "RGARotate.h"
+
+using namespace KODI::WINDOWING::GBM;
+
+#ifdef KODI_GBM_ROTATE
+
+#include "utils/log.h"
+
+#include <unistd.h>
+
+CRGARotate::CRGARotate(gbm_device* dev, int frameWidth, int frameHeight) : m_dev(dev)
+{
+  // initialize the 2D raster graphic acceleration unit (RGA)
+  c_RkRgaInit();
+
+  // RGA requires the buffer (virtual) height to be a multiple of 32.
+  int allocHeight = frameHeight;
+  if (allocHeight % 32 != 0)
+    allocHeight = (frameHeight + 32) & (~31);
+
+  // Allocate the pool of rotated portrait scanout buffers.
+  for (int i = 0; i < RGA_BUFFERS_MAX; ++i)
+  {
+    m_buffers[i] = gbm_bo_create(m_dev, frameWidth, allocHeight, GBM_FORMAT_XRGB8888,
+                                 GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+    if (!m_buffers[i])
+    {
+      CLog::Log(LOGERROR, "CRGARotate::{} - failed to allocate rotation buffer {}", __FUNCTION__, i);
+      return;
+    }
+
+    m_bufferPrimeFds[i] = gbm_bo_get_fd(m_buffers[i]);
+  }
+
+  // source: the landscape rendered buffer. Width/height are swapped relative to
+  // the destination because we rotate 90 degrees. The virtual width (stride)
+  // uses the padded height to match the destination buffer layout.
+  m_srcInfo.fd = -1;
+  m_srcInfo.mmuFlag = 1;
+  m_srcInfo.rotation = HAL_TRANSFORM_ROT_90;
+  rga_set_rect(&m_srcInfo.rect, 0, 0, frameHeight, frameWidth, allocHeight, frameWidth,
+               RK_FORMAT_BGRA_8888);
+
+  // destination: the portrait scanout buffer.
+  m_dstInfo.fd = -1;
+  m_dstInfo.mmuFlag = 1;
+  rga_set_rect(&m_dstInfo.rect, 0, 0, frameWidth, frameHeight, frameWidth, frameHeight,
+               RK_FORMAT_BGRA_8888);
+
+  m_valid = true;
+  CLog::Log(LOGDEBUG, "CRGARotate::{} - initialized RGA rotation {}x{} -> {}x{} (ROT_90)",
+            __FUNCTION__, frameHeight, frameWidth, frameWidth, frameHeight);
+}
+
+CRGARotate::~CRGARotate()
+{
+  if (m_srcFd >= 0)
+    close(m_srcFd);
+
+  for (int i = 0; i < RGA_BUFFERS_MAX; ++i)
+  {
+    if (m_bufferPrimeFds[i] > 0)
+      close(m_bufferPrimeFds[i]);
+    if (m_buffers[i])
+      gbm_bo_destroy(m_buffers[i]);
+  }
+
+  c_RkRgaDeInit();
+}
+
+gbm_bo* CRGARotate::Rotate(gbm_bo* src)
+{
+  if (!m_valid)
+    return src;
+
+  gbm_bo* dst = m_buffers[m_bufferIndex];
+
+  // gbm_bo_get_fd dups a new dmabuf fd on every call; close the previous one to
+  // avoid leaking a descriptor per frame.
+  if (m_srcFd >= 0)
+    close(m_srcFd);
+  m_srcFd = gbm_bo_get_fd(src);
+
+  m_srcInfo.fd = m_srcFd;
+  m_dstInfo.fd = m_bufferPrimeFds[m_bufferIndex];
+
+  if (c_RkRgaBlit(&m_srcInfo, &m_dstInfo, nullptr) < 0)
+    CLog::Log(LOGERROR, "CRGARotate::{} - RGA blit failed", __FUNCTION__);
+
+  m_bufferIndex = (m_bufferIndex + 1) % RGA_BUFFERS_MAX;
+
+  return dst;
+}
+
+#else // !KODI_GBM_ROTATE
+
+// Inert stub used when rotation is disabled at compile time (RG43H and all
+// non-RK3562 builds). No librga dependency.
+CRGARotate::CRGARotate(gbm_device* /*dev*/, int /*frameWidth*/, int /*frameHeight*/)
+{
+}
+
+CRGARotate::~CRGARotate() = default;
+
+gbm_bo* CRGARotate::Rotate(gbm_bo* src)
+{
+  return src;
+}
+
+#endif // KODI_GBM_ROTATE
diff --git a/xbmc/windowing/gbm/RGARotate.h b/xbmc/windowing/gbm/RGARotate.h
new file mode 100644
index 0000000..2d238ae
--- /dev/null
+++ b/xbmc/windowing/gbm/RGARotate.h
@@ -0,0 +1,83 @@
+/*
+ *  Copyright (C) 2005-2018 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// dArkOS RK3562 (RG52 Mini) software display rotation via the Rockchip RGA
+// 2D blitter. The RG52 Mini panel is physically portrait (720x1280) but used
+// in landscape. kodi-gbm scans out directly through GBM/KMS and bypasses the
+// patched SDL2 that rotates every other app, so the GUI appears sideways. The
+// VOP2 has no hardware ROTATE_90 (Esmart planes only), so we rotate each
+// rendered frame with RGA before page-flip, mirroring sdl2-patch-0004.
+//
+// Entirely gated by the compile-time define KODI_GBM_ROTATE (injected as
+// -DKODI_GBM_ROTATE=90 by build_kodi.sh for rg52mini only). When the define is
+// absent the class is an inert stub with no librga dependency, so the RG43H
+// (landscape-native) build is unaffected.
+
+#include <memory>
+
+#include <gbm.h>
+
+#ifdef KODI_GBM_ROTATE
+#include <rga/RgaApi.h>
+#include <rga/drmrga.h>
+#include <rga/rga.h>
+#endif
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+class CRGARotate
+{
+public:
+  /*!
+   * \brief Create the rotation engine and its pool of rotated scanout buffers.
+   * \param dev the gbm device used to allocate the rotated buffers
+   * \param frameWidth native (portrait) panel width  — the rotated buffer width
+   * \param frameHeight native (portrait) panel height — the rotated buffer height
+   */
+  CRGARotate(gbm_device* dev, int frameWidth, int frameHeight);
+  ~CRGARotate();
+
+  CRGARotate(const CRGARotate&) = delete;
+  CRGARotate& operator=(const CRGARotate&) = delete;
+
+  /*!
+   * \brief Rotate a landscape source buffer 90 degrees into a pooled portrait
+   *        scanout buffer.
+   * \param src the landscape (1280x720) front buffer produced by the GL surface
+   * \return a pooled portrait (720x1280) buffer holding the rotated frame, ready
+   *         to hand to DRM page-flip. Returns src unchanged when rotation is
+   *         disabled at compile time.
+   */
+  gbm_bo* Rotate(gbm_bo* src);
+
+private:
+#ifdef KODI_GBM_ROTATE
+  static constexpr int RGA_BUFFERS_MAX = 3;
+
+  gbm_device* m_dev{nullptr};
+  gbm_bo* m_buffers[RGA_BUFFERS_MAX]{};
+  int m_bufferPrimeFds[RGA_BUFFERS_MAX]{};
+  int m_bufferIndex{0};
+  int m_srcFd{-1};
+  bool m_valid{false};
+
+  rga_info_t m_srcInfo{};
+  rga_info_t m_dstInfo{};
+#endif
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
